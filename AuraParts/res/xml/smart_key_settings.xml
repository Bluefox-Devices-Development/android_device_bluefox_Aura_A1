<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/gesture_category_title">
        <Preference
            android:key="smart_key_single"
            android:iconSpaceReserved="false"
            android:title="@string/gesture_single" />

        <Preference
            android:key="smart_key_double"
            android:iconSpaceReserved="false"
            android:title="@string/gesture_double" />

        <Preference
            android:key="smart_key_long"
            android:iconSpaceReserved="false"
            android:title="@string/gesture_long" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/information_category_title">
        <Preference
            android:iconSpaceReserved="false"
            android:selectable="false"
            android:summary="@string/double_press_delay_summary"
            android:title="@string/double_press_delay_title" />

        <Preference
            android:iconSpaceReserved="false"
            android:selectable="false"
            android:summary="@string/screen_off_summary"
            android:title="@string/screen_off_title" />
    </PreferenceCategory>
</PreferenceScreen>
