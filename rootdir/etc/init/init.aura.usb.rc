# Keep the board's configfs/FunctionFS setup and charger-mode policy. The
# source gadget service uses ncm.gs9, while the stock setup also owns ncm.gs6.
# post-fs-data runs after every board post-fs action has created g1/functions.
on post-fs-data
    mkdir /config/usb_gadget/g1/functions/ncm.gs9
    write /config/usb_gadget/g1/functions/ncm.gs9/os_desc/interface.ncm/compatible_id WINNCM
    write /config/usb_gadget/g1/functions/ncm.gs9/ifname ncm%d

on boot
    setprop sys.usb.controller musb-hdrc
    setprop vendor.usb.controller musb-hdrc
    chown system system /sys/class/typec/port0/power_role
    chown system system /sys/class/typec/port0/data_role
    chown system system /sys/class/typec/port0/port_type
    chmod 0664 /sys/class/typec/port0/power_role
    chmod 0664 /sys/class/typec/port0/data_role
    chmod 0664 /sys/class/typec/port0/port_type
    chown root system /config/usb_gadget
    chown root system /config/usb_gadget/g1
    chown root system /config/usb_gadget/g1/UDC
    chmod 0664 /config/usb_gadget/g1/UDC
    chown system system /sys/class/udc/${sys.usb.controller}/device/cmode
    setprop vendor.usb.functions.ready 1

# Hand ownership to the gadget HAL only in normal boot, after board setup.
# configfs=2 disables the stock configfs=1 function-switching actions and
# enables vendor.usb-gadget-hal. Charger/early-ADB mode keeps the legacy path.
on property:vendor.usb.functions.ready=1 && property:ro.bootmode=normal && property:sys.usb.configfs=1
    setprop sys.usb.configfs 2
